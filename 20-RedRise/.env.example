# RedRise Environment Variables

# --- Optional: Dify API for Phase 1 (Herbal) ---
# Get your API key from Dify dashboard. Leave empty to use local RAG only.
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1

# --- Local RAG ---
# Path to ChromaDB persistence folder (relative or absolute)
CHROMA_PERSIST_DIR=./redrise_db

# Embedding model used for local retrieval (same as ingestion)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ollama ---
# Model name (must match the one you pulled)
OLLAMA_MODEL=deepseek-med-8b:q4_K_M
OLLAMA_HOST=http://localhost:11434

# --- Feature Flags ---
# Set to "false" to force local RAG even for herbal queries (disable Dify)
REDRISE_USE_DIFY_FALLBACK=true

# --- Server ---
# FastAPI host and port (set via command line, but can be overridden here)
HOST=0.0.0.0
PORT=8000
